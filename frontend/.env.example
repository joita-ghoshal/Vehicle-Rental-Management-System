# Frontend build settings (copy to .env.production.local when needed).
# Single-origin hosting (recommended): build with VITE_BASE=/
# GitHub Pages keeps the repository sub-path default.
VITE_BASE=/

# Leave empty for single-origin. For a separately hosted API, use its origin:
# VITE_API_URL=https://zelvora-api.example.com

# Local dev/preview proxy target.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Copy this file to ".env" (same folder) and put your own MySQL details here.
# The ".env" file is ignored by Git so your password stays private.
ZELVORA_DB_HOST=127.0.0.1
ZELVORA_DB_PORT=3306
ZELVORA_DB_USER=root
ZELVORA_DB_PASSWORD=your_mysql_password
ZELVORA_DB_NAME=zelvora_db
ZELVORA_API_PORT=8000
# Keep 0 for private data. `python demo.py ...` selects an isolated database
# and enables demo mode for that process only; it never edits your .env.
ZELVORA_DEMO_MODE=0

# ---- Production/hosting (all optional locally) --------------------------
# development keeps loopback-only; production enables Secure cookies.
ZELVORA_ENV=development
# Set to 0.0.0.0 only on a hosting platform.
ZELVORA_API_HOST=127.0.0.1
# Built React app served by the Python API (single-origin). Relative to backend/.
# ZELVORA_STATIC_DIR=../frontend/dist
# Comma-separated origins for split-origin deployments only.
# ZELVORA_ALLOWED_ORIGINS=https://app.example.com
# ZELVORA_COOKIE_SECURE=0
# Lax (same-origin) or None (cross-origin HTTPS only).
# ZELVORA_COOKIE_SAMESITE=Lax
# memory keeps the local behaviour; db survives backend restarts.
# ZELVORA_SESSION_STORE=memory
# Hosting only: apply idempotent migrations at startup.
# ZELVORA_AUTO_MIGRATE=0
